POSTGRES_DB=gestisoft
POSTGRES_USER=gestisoft
POSTGRES_PASSWORD=CAMBIA_QUESTA_PASSWORD
POSTGRES_HOST_PORT=5432

API_HOST_PORT=5080
FRONTEND_HOST_PORT=8081
FRONTEND_ORIGIN=http://localhost:8081

ASPNETCORE_ENVIRONMENT=Production

# JWT: Secret deve essere una stringa casuale lunga almeno 32 caratteri (es. `openssl rand -base64 48`).
JWT_ISSUER=GestiSoft.Gestionale
JWT_AUDIENCE=GestiSoft.Gestionale.Client
JWT_SECRET=CAMBIA_QUESTA_CHIAVE_CASUALE_ALMENO_32_CARATTERI
JWT_LIFETIME_MINUTES=60

# Letti solo al primissimo avvio per creare il Super Admin iniziale (poi si cambia password
# dalla UI/API — questi valori non servono più dopo il primo boot).
SUPERADMIN_EMAIL=admin@tuodominio.it
SUPERADMIN_PASSWORD=CAMBIA_QUESTA_PASSWORD

# URL base del backend esterno "gestisoft" (licenze/abbonamenti, GestiSoftWeb/UserService, già in
# produzione) — necessario per Wubook (Fase 5) E per PayTourist (Fase 8, che ne legge l'Id Software
# dalla stessa risposta di licenza). Lasciare vuoto finché non si punta a un'istanza reale: le
# chiamate falliscono con un errore gestito, non bloccano l'avvio.
GESTISOFT_BASE_URL=

# URL del servizio SOAP "Alloggiati Web" della Polizia di Stato — lasciare vuoto finché non si
# dispone dell'endpoint ufficiale (produzione o collaudo) fornito dalla Questura: le chiamate
# falliscono con un errore gestito finché non è configurato, non bloccano l'avvio.
ALLOGGIATIWEB_ENDPOINT=

# URL base del servizio REST/XML dell'Osservatorio Turistico — lasciare vuoto finché non si
# dispone dell'endpoint ufficiale (varia per regione/ente): stesso trattamento di ALLOGGIATIWEB_ENDPOINT.
OSSERVATORIO_BASE_URL=

# URL base del servizio REST/JSON PayTourist — a differenza degli altri endpoint qui sopra, PayTourist
# assegna un sottodominio diverso per ogni Comune (es. https://palermo.paytourist.com), quindi questo
# è un TEMPLATE con il segnaposto "{comune}", sostituito a runtime con lo slug del Comune Attività
# (Impostazioni Generali) di ogni Struttura: minuscolo, senza spazi/accenti/apostrofi.
# Lasciare vuoto finché non si dispone dell'endpoint ufficiale.
PAYTOURIST_BASE_URL=https://{comune}.paytourist.com

# Cifra a riposo le credenziali dei servizi esterni salvate nel database (token PayTourist, utenza
# Alloggiati Web, password Osservatorio, token OTA). Obbligatoria: senza, l'Api non parte.
# Genera con: openssl rand -base64 32
# Sta fuori dal database di proposito — protegge proprio dal caso in cui giri una copia del
# database — e va conservata insieme agli altri segreti: perdendola, le credenziali già salvate
# non sono più rileggibili e vanno reinserite a mano.
CREDENZIALI_CHIAVE_CIFRATURA=

# Da valorizzare SOLO mentre si cambia la chiave, con la chiave vecchia: all'avvio l'applicazione
# rilegge con questa e riscrive tutto con quella nuova, poi va tolta. Procedura in docs/deploy.md.
CREDENZIALI_CHIAVE_CIFRATURA_PRECEDENTE=
