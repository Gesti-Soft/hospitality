# .env dell'ambiente di test (test.gestihotel.it). Sulla VPS, nella cartella di test:
#   cp docker-compose.test.env.example .env
# Le variabili non elencate qui prendono i default di docker-compose.yml; per le altre (email,
# commenti estesi) vedi docker-compose.env.example.
#
# Regole del test:
# - SOLO DATI SINTETICI: mai un dump della produzione (ospiti e documenti veri, credenziali delle PA).
# - Segreti propri: nessun valore copiato dal .env di produzione.
# - Niente endpoint delle PA: Alloggiati Web, Osservatorio e PayTourist restano vuoti.

# Nome del progetto Compose: separa volumi e rete da quelli di produzione. Non cambiarlo dopo il
# primo avvio, o si riparte con un database vuoto.
COMPOSE_PROJECT_NAME=gestisoft-test
# Stack base + override di test (nomi dei container, worker spenti, Postgres senza archiviazione).
COMPOSE_FILE=docker-compose.yml:docker-compose.test.yml
# Vuoto = worker e worker-schedine spenti. "worker" accende i job OTA/notifiche (vedi
# docker-compose.test.yml prima di farlo). Mai "sdi" né "mai-in-test".
COMPOSE_PROFILES=

POSTGRES_DB=gestisoft
POSTGRES_USER=gestisoft
# openssl rand -base64 32
POSTGRES_PASSWORD=

# Porte sull'host (solo 127.0.0.1), diverse da quelle di produzione. Verificare che siano libere:
#   sudo ss -tulpn | grep -E ':(5434|5081|8083)\b'
POSTGRES_HOST_PORT=5434
API_HOST_PORT=5081
FRONTEND_HOST_PORT=8083
FRONTEND_ORIGIN=https://test.gestihotel.it

ASPNETCORE_ENVIRONMENT=Production

JWT_ISSUER=GestiSoft.Gestionale
JWT_AUDIENCE=GestiSoft.Gestionale.Client
# openssl rand -base64 48
JWT_SECRET=
JWT_LIFETIME_MINUTES=60

# Super Admin del test, creato al primo avvio sul database vuoto.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# openssl rand -base64 32 (obbligatoria, l'Api non parte senza)
CREDENZIALI_CHIAVE_CIFRATURA=
CREDENZIALI_CHIAVE_CIFRATURA_PRECEDENTE=

GESTISOFT_BASE_URL=
ALLOGGIATIWEB_ENDPOINT=
OSSERVATORIO_BASE_URL=
PAYTOURIST_BASE_URL=

# Vuoto: niente ricezione diretta delle prenotazioni OTA sul test.
OTA_AVVISI_SEGRETO=

# Vuoto: nessuna email dal test.
EMAIL_SMTP_HOST=

# Fatture finte: in collaudo invio e ricevute cambiano lo stato delle fatture, come in produzione.
# MAI nel .env di produzione.
SDI_COLLAUDO_APPLICA_ESITI=true
